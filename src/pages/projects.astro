---
import Layout from "../layouts/Layout.astro";
import PageHeader from "../components/PageHeader.astro";
import CardProject from "../components/CardProject.astro";
import { projects } from "../data/projects";

// auto-fit + minmax : autant de colonnes de 460px minimum que la largeur le permet (2 sur desktop),
// une seule sur mobile ; min(100%, 460px) évite qu'une carte déborde sur un écran plus étroit.
const count = projects.length;
---

<Layout title="Projets">
	<section class="mx-auto max-w-1200 px-24 pt-88">
		<PageHeader
			eyebrow="// Projets"
			title="Mes"
			highlight="Projets"
			intro="Voici quelques projets sur lesquels j’ai travaillé pour mettre en pratique mes compétences techniques et ma passion pour le développement web."
		>
			<span
				class="rounded-full border border-card-border bg-card px-14 py-6 font-mono text-13 text-white/70"
			>
				{count} projet{count > 1 && "s"}
			</span>
		</PageHeader>
	</section>

	<section class="mx-auto max-w-1200 px-24 pt-48">
		<div
			class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,460px),1fr))] gap-24"
		>
			{projects.map((project) => <CardProject {...project} />)}
		</div>
	</section>
</Layout>
