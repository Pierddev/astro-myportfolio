---
import Layout from "../layouts/Layout.astro";
import Mycard from "../components/mycard.astro";
import IconArrowRight from "../components/icons/IconArrowRight.astro";
import IconArrowTopRight from "../components/icons/iconArrowTopRight.astro";
import ContactForm from "src/components/ContactForm.astro";
import Spacer from "src/components/Spacer.astro";
import logoAstro from "../assets/stacks/astro.webp";
import { Image } from "astro:assets";
import SioDashImg from "../assets/project-siodash.webp";
import logoFlask from "../assets/stacks/flask.webp";
import logoJinja from "../assets/stacks/jinja.webp";
import logoVercel from "../assets/stacks/vercel.webp";
import logoPostgresql from "../assets/stacks/postgresql.webp";

// « En ce moment » : les activités en cours, sur-titre en couleur
const currently = [
	{
		label: "Freelance",
		title: "Pi-Code Studio",
		detail: "Développeur web · depuis 2025",
		color: "text-bleu-glacier",
	},
	{
		label: "Alternance",
		title: "BRETIM",
		detail: "Assistant service informatique",
		color: "text-lavande-fonce",
	},
	{
		label: "Formation",
		title: "BTS SIO · SLAM",
		detail: "MDS Rennes · 2025 – 2027",
		color: "text-orchidee",
	},
];
---

<Layout>
	<!-- Carte de profil à gauche et texte à droite (l'inverse de la page À propos). flex 999 : le texte
	     prend toute la place restante ; sous 520px + 300px, il passe sous la carte. -->
	<section
		id="top"
		class="mx-auto flex max-w-1200 flex-wrap items-center gap-56 px-24 pt-80"
	>
		<Mycard class="mx-auto flex-[0_1_300px]" />

		<div class="flex min-w-0 flex-[999_1_520px] flex-col items-start gap-28">
			<a
				href="#contact"
				class="glass-btn inline-flex items-center gap-12 rounded-full px-14 py-8 text-14 text-white/75"
			>
				<span aria-hidden="true" class="relative flex size-10">
					<span
						class="absolute inset-0 animate-ping rounded-full bg-emeraude opacity-70"
					></span>
					<span class="relative size-10 rounded-full bg-emeraude-fonce"></span>
				</span>
				<span>Vous pouvez me contacter à tout moment</span>
				<IconArrowRight class="size-18 flex-none" />
			</a>

			<h1
				class="text-[clamp(38px,5.2vw,72px)] leading-[1.06] font-semibold tracking-[-0.025em]"
			>
				Développeur Web &<br />
				<span class="gradient-text">Administrateur Systèmes</span>
			</h1>

			<p class="max-w-560 text-17 leading-[1.7] text-white/72">
				Passionné d’informatique, je me spécialise en informatique réseau et
				cybersécurité. Curieux et rigoureux, j’aime comprendre et optimiser les
				systèmes. Découvrez mon parcours !
			</p>

			<div class="flex flex-wrap gap-12">
				<a
					href="#contact"
					class="grad-btn inline-flex min-h-48 items-center gap-10 rounded-full px-24 text-15 font-medium shadow-cta"
				>
					<span>Me contacter</span>
					<IconArrowRight class="size-18" />
				</a>
				<a
					href="#projets"
					class="glass-btn inline-flex min-h-48 items-center rounded-full px-24 text-15 font-medium text-white/88"
				>
					Voir mes projets
				</a>
			</div>

			<div class="mt-12 w-full">
				<p class="mb-12 font-mono text-12 tracking-[0.06em] text-white/55">
					EN CE MOMENT
				</p>
				<ul class="flex flex-wrap gap-12">
					{
						currently.map(({ label, title, detail, color }) => (
							<li class="flex-[1_1_180px] rounded-20 border border-white/9 bg-white/4 px-18 py-16">
								<p
									class:list={[
										"text-11 font-medium tracking-[0.08em] uppercase",
										color,
									]}
								>
									{label}
								</p>
								<p class="mt-6 text-15 font-semibold">{title}</p>
								<p class="mt-2 text-13 text-white/60">{detail}</p>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<section class="mx-auto flex max-w-1200 flex-col items-center px-24">
		<!-- Section Projet à la une -->
		<div class="flex flex-col w-full justify-center items-center mt-60">
			<span class="text-30 font-semibold">Projet à la une</span>
			<Spacer class="my-20" />
			<!-- Card avec image en background -->
			<a
				href="https://siodash.fr/"
				target="_blank"
				class="group bloc-card relative w-full max-w-700 h-400 lg:h-450 rounded-45 overflow-hidden cursor-pointer"
			>
				<!-- Background Image -->
				<Image
					class="absolute inset-0 w-full h-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
					src={SioDashImg}
					alt="Aperçu du projet SioDash"
					loading={"eager"}
				/>
				<!-- Gradient Overlay -->
				<div
					class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-transparent"
				>
				</div>
				<!-- Content -->
				<div
					class="absolute bottom-0 left-0 right-0 p-25 lg:p-35 flex flex-col gap-15"
				>
					<div>
						<h3 class="text-25 lg:text-35 font-bold text-white">SioDash</h3>
						<p
							class="text-12 lg:text-14 text-white/70 mt-8 max-w-500 line-clamp-2"
						>
							Une plateforme centralisée pour les étudiants en BTS SIO
							permettant de suivre leurs missions, compétences et parcours
							professionnel.
						</p>
					</div>
					<div class="flex flex-wrap gap-8">
						{
							[
								{ src: logoFlask, name: "Flask" },
								{ src: logoJinja, name: "Jinja" },
								{ src: logoPostgresql, name: "PostgreSQL" },
								{ src: logoVercel, name: "Vercel" },
							].map(({ src, name }) => (
								<div class="flex items-center gap-5 bg-white/10 border-1 border-white/20 rounded-full px-12 py-5">
									<Image src={src} alt={name} class="size-16" />
									<span class="text-11 text-white/90">{name}</span>
								</div>
							))
						}
					</div>
					<div class="flex items-center gap-8 text-white/60">
						<span class="text-12 lg:text-14 font-medium">Voir le projet</span>
						<IconArrowTopRight class="size-18" />
					</div>
				</div>
			</a>
		</div>
		<div class="flex flex-col w-full justify-center items-center mt-60">
			<span class="text-30 font-semibold">Mon choix du moment</span>
			<Spacer class="my-20" />
			<div
				class="bloc-card relative flex items-center rounded-45 p-15 xl:p-30"
			>
				<Image
					class="w-50 h-63 xl:w-100 xl:h-auto ml-15 xl:ml-0"
					src={logoAstro}
					alt="Logo du Framework Astro"
				/>
				<div class="spacer-choice"></div>
				<div class="text-center">
					<div class="text-20 lg:text-25 xl:text-30 font-semibold">Astro</div>
					<div class="text-12 lg:text-15 max-w-320 xl:max-w-500">
						Un framework ultra rapide, simple et moderne pour créer des sites
						performants avec une structure propre et flexible. Mon portfolio
						est entièrement construit avec Astro.
					</div>
				</div>
			</div>
		</div>
		<Spacer class="mt-20" />
		<div class="mt-50">
			<ContactForm />
		</div>
	</section>
</Layout>
