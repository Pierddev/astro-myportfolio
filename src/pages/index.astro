---
import Layout from "../layouts/Layout.astro";
import Mycard from "../components/mycard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import CardProjectFeatured from "../components/CardProjectFeatured.astro";
import CardProjectLink from "../components/CardProjectLink.astro";
import IconArrowRight from "../components/icons/IconArrowRight.astro";
import IconArrowTopRight from "../components/icons/iconArrowTopRight.astro";
import ContactForm from "../components/ContactForm.astro";
import logoAstro from "../assets/stacks/astro.webp";
import { Image } from "astro:assets";
import { projects } from "../data/projects";
import { stackHighlights } from "../data/stack";

// « En ce moment » : les activités en cours, sur-titre en couleur
const currently = [
	{
		label: "Freelance",
		title: "Pi-Code Studio",
		detail: "Développeur web · depuis 2025",
		color: "text-bleu-glacier",
	},
	{
		label: "Alternance",
		title: "BRETIM",
		detail: "Assistant service informatique",
		color: "text-lavande-fonce",
	},
	{
		label: "Formation",
		title: "BTS SIO · SLAM",
		detail: "MDS Rennes · 2025 – 2027",
		color: "text-orchidee",
	},
];

// Le projet featured est mis en avant ; les autres remplissent « Autres réalisations ».
// slice(0, 3) : une seule ligne de cartes, le lien « Tous les projets » mène au reste.
const featured = projects.find((project) => project.featured);
const others = projects.filter((project) => !project.featured).slice(0, 3);
---

<Layout>
	<!-- Carte de profil à gauche et texte à droite (l'inverse de la page À propos). flex 999 : le texte
	     prend toute la place restante ; sous 520px + 300px, il passe sous la carte. -->
	<section
		id="top"
		class="mx-auto flex max-w-1200 flex-wrap items-center gap-56 px-24 pt-80"
	>
		<Mycard class="mx-auto flex-[0_1_300px]" />

		<div class="flex min-w-0 flex-[999_1_520px] flex-col items-start gap-28">
			<a
				href="#contact"
				class="glass-btn inline-flex items-center gap-12 rounded-full px-14 py-8 text-14 text-white/75"
			>
				<span aria-hidden="true" class="relative flex size-10">
					<span
						class="absolute inset-0 animate-ping rounded-full bg-emeraude opacity-70"
					></span>
					<span class="relative size-10 rounded-full bg-emeraude-fonce"></span>
				</span>
				<span>Vous pouvez me contacter à tout moment</span>
				<IconArrowRight class="size-18 flex-none" />
			</a>

			<h1
				class="text-[clamp(38px,5.2vw,72px)] leading-[1.06] font-semibold tracking-[-0.025em]"
			>
				Développeur Web &<br />
				<span class="gradient-text">Administrateur Systèmes</span>
			</h1>

			<p class="max-w-560 text-17 leading-[1.7] text-white/72">
				Passionné d’informatique, je me spécialise en informatique réseau et
				cybersécurité. Curieux et rigoureux, j’aime comprendre et optimiser les
				systèmes. Découvrez mon parcours !
			</p>

			<div class="flex flex-wrap gap-12">
				<a
					href="#contact"
					class="grad-btn inline-flex min-h-48 items-center gap-10 rounded-full px-24 text-15 font-medium shadow-cta"
				>
					<span>Me contacter</span>
					<IconArrowRight class="size-18" />
				</a>
				<a
					href="#projets"
					class="glass-btn inline-flex min-h-48 items-center rounded-full px-24 text-15 font-medium text-white/88"
				>
					Voir mes projets
				</a>
			</div>

			<div class="mt-12 w-full">
				<p class="mb-12 font-mono text-12 tracking-[0.06em] text-white/55">
					EN CE MOMENT
				</p>
				<ul class="flex flex-wrap gap-12">
					{
						currently.map(({ label, title, detail, color }) => (
							<li class="flex-[1_1_180px] rounded-20 border border-white/9 bg-white/4 px-18 py-16">
								<p
									class:list={[
										"text-11 font-medium tracking-[0.08em] uppercase",
										color,
									]}
								>
									{label}
								</p>
								<p class="mt-6 text-15 font-semibold">{title}</p>
								<p class="mt-2 text-13 text-white/60">{detail}</p>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</section>

	<section id="projets" class="mx-auto max-w-1200 px-24 pt-140">
		<SectionHeading eyebrow="01 — Projets" title="Projet à la une">
			<a
				href="/projects"
				class="text-link inline-flex min-h-44 items-center gap-8 text-15 text-white/70"
			>
				<span>Tous les projets</span>
				<IconArrowRight class="size-18" />
			</a>
		</SectionHeading>

		{featured && <CardProjectFeatured {...featured} />}

		<h3 class="mt-56 mb-20 text-20 font-semibold">Autres réalisations</h3>
		<div class="flex flex-wrap gap-24">
			{others.map((project) => <CardProjectLink {...project} />)}
		</div>
	</section>

	<section id="stack" class="mx-auto max-w-1200 px-24 pt-140">
		<SectionHeading
			eyebrow="02 — Stack"
			title="Stack technique & choix du moment"
		/>

		<div class="flex flex-wrap items-stretch gap-24">
			<div
				class="flex min-w-0 flex-[1.5_1_520px] flex-col gap-24 rounded-36 border border-card-border bg-card p-24 sm:p-32"
			>
				<p class="max-w-560 text-15 leading-[1.7] text-white/72">
					Un aperçu des technologies que j’utilise ou ai utilisées pour
					développer des applications web efficaces et actuelles.
				</p>
				<div
					class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-x-28 gap-y-24"
				>
					{
						stackHighlights.map(({ title, items }) => (
							<div>
								<h3 class="mb-10 text-12 font-medium tracking-[0.06em] text-white/55 uppercase">
									{title}
								</h3>
								<ul class="flex flex-wrap gap-8">
									{items.map(({ logoSrc, name, invert }) => (
										<li class="inline-flex items-center gap-8 rounded-12 border border-white/10 bg-white/6 py-6 pr-12 pl-8 text-13">
											<Image
												src={logoSrc}
												alt=""
												width={36}
												class:list={["size-18 object-contain", invert && "invert"]}
											/>
											{name}
										</li>
									))}
								</ul>
							</div>
						))
					}
				</div>
				<a
					href="/stack"
					class="text-link mt-auto inline-flex min-h-44 items-center gap-8 self-start text-14 text-white/70"
				>
					<span>Voir toute la stack</span>
					<IconArrowRight class="size-18" />
				</a>
			</div>

			<div
				class="relative flex min-w-0 flex-[1_1_340px] flex-col gap-20 overflow-hidden rounded-36 border border-card-border bg-card p-24 sm:p-32"
			>
				<div
					aria-hidden="true"
					class="pointer-events-none absolute -top-80 -right-80 size-260 bg-radial-[closest-side] from-astro/35 to-transparent"
				>
				</div>
				<p
					class="relative text-12 font-medium tracking-[0.06em] text-white/55 uppercase"
				>
					Mon choix du moment
				</p>
				<div class="relative flex items-center gap-18">
					<span
						class="flex size-72 flex-none items-center justify-center rounded-20 border border-white/12 bg-white/6"
					>
						<Image
							src={logoAstro}
							alt="Logo du framework Astro"
							width={68}
							class="h-43 w-34 object-contain"
						/>
					</span>
					<h3 class="text-30 font-semibold tracking-[-0.02em]">Astro</h3>
				</div>
				<p class="relative text-15 leading-[1.7] text-white/72">
					Un framework ultra rapide, simple et moderne pour créer des sites
					performants avec une structure propre et flexible. Mon portfolio est
					entièrement construit avec Astro.
				</p>
				<a
					href="https://astro.build/"
					target="_blank"
					rel="noopener noreferrer"
					class="glass-btn relative mt-auto inline-flex min-h-44 items-center gap-8 self-start rounded-full px-18 text-14 text-white/85"
				>
					<span>En savoir plus</span>
					<IconArrowTopRight class="size-18" />
				</a>
			</div>
		</div>
	</section>

	<section class="mx-auto max-w-1200 px-24 pt-140">
		<ContactForm />
	</section>
</Layout>
