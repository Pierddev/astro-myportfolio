---
import IconHome from "../components/icons/IconHome.astro";
import IconAbout from "../components/icons/IconAbout.astro";
import IconContact from "../components/icons/IconContact.astro";
import IconClose from "../components/icons/IconClose.astro";
import IconProject from "../components/icons/IconProject.astro";
import IconStack from "../components/icons/IconStack.astro";
import IconBurger from "../components/icons/IconBurger.astro";

const { currentPath } = Astro.props;
const currentPage = currentPath.split("/").filter(Boolean)[0] || "home";

// Contact n'est plus un onglet : c'est le bouton en dégradé, à la fin de la pilule.
const links = [
	{ page: "home", href: "/", label: "Accueil", icon: IconHome },
	{ page: "about", href: "/about", label: "À propos", icon: IconAbout },
	{ page: "stack", href: "/stack", label: "Stack", icon: IconStack },
	{ page: "projects", href: "/projects", label: "Projets", icon: IconProject },
].map((link) => ({ ...link, isActive: link.page === currentPage }));

// Style d'un onglet selon qu'il est actif ou non (pilule desktop et menu mobile)
const tabState = (isActive: boolean) =>
	isActive
		? "border-white/12 bg-white/8 text-white"
		: "border-transparent text-white/72 hover:bg-white/6 hover:text-white";
---

<!-- NAVBAR - Mobile Version -->
<div
	class="pointer-events-auto relative z-10 flex w-full items-center justify-between rounded-full border border-white/10 bg-background/55 p-6 pl-18 backdrop-blur-[14px] lg:hidden"
>
	<a href="/" class="text-18 font-semibold tracking-[-0.01em] text-bleu-glacier"
		>Pierre.</a
	>
	<!-- aria-expanded passe à "true" quand le menu est ouvert (public/js/script.js) : l'icône change via group-aria-expanded -->
	<button
		id="burger"
		type="button"
		aria-label="Menu"
		aria-expanded="false"
		aria-controls="mobileMenu"
		class="group glass-btn flex size-44 items-center justify-center rounded-full"
	>
		<IconBurger class="size-22 group-aria-expanded:hidden" />
		<IconClose class="hidden size-22 group-aria-expanded:block" />
	</button>
</div>

<!-- MENU mobile : caché par l'attribut hidden tant que le burger ne l'a pas ouvert -->
<nav
	id="mobileMenu"
	aria-label="Navigation principale"
	hidden
	class="pointer-events-auto fixed inset-0 flex flex-col items-center justify-center gap-8 bg-background/90 px-24 backdrop-blur-[14px] lg:hidden"
>
	{
		links.map(({ href, label, icon: Icon, isActive }) => (
			<a
				href={href}
				aria-current={isActive ? "page" : undefined}
				class:list={[
					"flex w-full max-w-320 items-center justify-center gap-10 rounded-full border px-24 py-12 text-17 transition-colors duration-200",
					tabState(isActive),
				]}
			>
				<Icon class="size-20" />
				<span>{label}</span>
			</a>
		))
	}
	<a
		href="/#contact"
		class="grad-btn mt-16 flex min-h-48 w-full max-w-320 items-center justify-center gap-8 rounded-full text-15 font-medium shadow-cta"
	>
		<IconContact class="size-18" />
		<span>Contact</span>
	</a>
</nav>

<!-- NAVBAR - PC Version -->
<nav
	aria-label="Navigation principale"
	class="pointer-events-auto hidden items-center gap-4 rounded-full border border-white/10 bg-background/55 p-6 backdrop-blur-[14px] lg:flex"
>
	<a
		href="/"
		class="py-8 pr-16 pl-18 text-18 font-semibold tracking-[-0.01em] text-bleu-glacier"
		>Pierre.</a
	>
	<span aria-hidden="true" class="mx-4 h-22 w-1 bg-white/12"></span>
	{
		links.map(({ href, label, icon: Icon, isActive }) => (
			<a
				href={href}
				aria-current={isActive ? "page" : undefined}
				class:list={[
					"flex items-center gap-8 rounded-full border px-16 py-10 text-14 transition-colors duration-200",
					tabState(isActive),
				]}
			>
				<Icon class="size-18" />
				<span>{label}</span>
			</a>
		))
	}
	<a
		href="/#contact"
		class="grad-btn ml-4 flex items-center gap-8 rounded-full px-18 py-10 text-14 font-medium"
	>
		<IconContact class="size-18" />
		<span>Contact</span>
	</a>
</nav>
