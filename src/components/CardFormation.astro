---
import IconGraduationCap from "./icons/IconGraduationCap.astro";
import StatusBadge from "./StatusBadge.astro";
import type { Formation } from "../lib/parcours";

// Carte d'une formation (page À propos). La formation en cours est mise en avant :
// fond et bordure bleutés, icône bleu glacier et badge « En cours ».
type Props = Formation;

const { isCurrent, date, formation, ecole, lieu } = Astro.props;
---

<div
	class:list={[
		"lift rounded-28 border p-24",
		isCurrent
			? "border-bleu-glacier/30 bg-bleu-glacier/7"
			: "border-card-border bg-card",
	]}
>
	<div class="flex items-center justify-between gap-12">
		<span
			class:list={[
				"flex size-44 items-center justify-center rounded-14 border border-white/12 bg-white/6",
				isCurrent ? "text-bleu-glacier" : "text-white/85",
			]}
		>
			<IconGraduationCap class="size-22" />
		</span>
		{isCurrent && <StatusBadge>En cours</StatusBadge>}
	</div>
	<p class="mt-18 font-mono text-12 tracking-[0.04em] text-white/60">{date}</p>
	<h3 class="mt-6 text-19 font-semibold">{formation}</h3>
	<p class="mt-4 text-14 text-white/75">{ecole} · {lieu}</p>
</div>
