---
import { Image } from "astro:assets";
import IconLocation from "./icons/IconLocation.astro";
import IconChevronDown from "./icons/IconChevronDown.astro";
import StatusBadge from "./StatusBadge.astro";
import type { Experience } from "../lib/parcours";

// Entrée de la timeline des expériences (page À propos) : pastille sur la ligne, carte, missions dépliables.
// Sans JavaScript, toutes les missions sont dépliées dans le HTML ; le script ci-dessous replie celles
// qui ne sont pas ouvertes par défaut (defaultOpen) au chargement.
interface Props extends Experience {
	defaultOpen?: boolean;
}

const {
	id,
	isCurrent,
	date,
	poste,
	entreprise,
	lieu,
	logoSrc,
	logoAlt,
	missions,
	defaultOpen = false,
} = Astro.props;

const missionsId = `missions-${id}`;
---

<li class="relative pl-44">
	<!-- Pastille : l'anneau (shadow) à la couleur du fond coupe la ligne de la timeline -->
	<span
		aria-hidden="true"
		class="absolute top-30 left-4 flex size-18 items-center justify-center rounded-full bg-white/10 shadow-[0_0_0_4px_var(--color-background)]"
	>
		<span
			class:list={[
				"size-8 rounded-full",
				isCurrent ? "bg-emeraude" : "bg-white/70",
			]}
		></span>
	</span>

	<article
		class="rounded-28 border border-card-border bg-card p-20 transition-colors duration-300 hover:border-white/18"
	>
		<div class="flex flex-wrap items-center gap-20">
			<div
				class="flex size-76 flex-none items-center justify-center rounded-20 bg-white p-8"
			>
				<Image
					src={logoSrc}
					alt={logoAlt}
					width={120}
					class="max-h-full max-w-full object-contain"
				/>
			</div>

			<div class="min-w-0 flex-[1_1_280px]">
				<div class="flex flex-wrap items-center gap-10">
					<p class="font-mono text-12 tracking-[0.04em] text-white/60">
						{date}
					</p>
					{isCurrent && <StatusBadge>En cours</StatusBadge>}
				</div>
				<h3 class="mt-6 text-20 leading-[1.3] font-semibold">{poste}</h3>
				<p
					class="mt-4 flex flex-wrap items-center gap-6 text-14 text-white/70"
				>
					<span class="font-medium text-white/88">{entreprise}</span>
					<span aria-hidden="true">·</span>
					<IconLocation class="size-16" />
					<span>{lieu}</span>
				</p>
			</div>

			<!-- État dans aria-expanded, que lit la classe group-aria-expanded: du chevron -->
			<button
				type="button"
				data-missions-toggle
				data-default-open={String(defaultOpen)}
				data-label-open="Masquer les missions"
				data-label-closed={`Voir les missions (${missions.length})`}
				aria-expanded="true"
				aria-controls={missionsId}
				class="glass-btn group flex min-h-44 flex-none cursor-pointer items-center gap-8 rounded-full pr-16 pl-18 text-13 text-white/85"
			>
				<span data-missions-label>Masquer les missions</span>
				<IconChevronDown
					class="size-18 transition-transform duration-300 group-aria-expanded:rotate-180"
				/>
			</button>
		</div>

		<!-- Dépliage progressif : la ligne de grille passe de 0fr à 1fr, ce qui anime la hauteur réelle
		     des missions. invisible (visibility) les retire du lecteur d'écran une fois repliées ; la
		     transition de visibility les garde visibles pendant toute l'animation, dans les deux sens.
		     data-animated n'est posé qu'après le repli initial, pour ne pas l'animer au chargement. -->
		<div
			id={missionsId}
			data-open="true"
			class="grid grid-rows-[1fr] duration-500 ease-smooth data-animated:transition-[grid-template-rows,opacity,visibility] data-[open=false]:invisible data-[open=false]:grid-rows-[0fr] data-[open=false]:opacity-0"
		>
			<div class="min-h-0 overflow-hidden">
				<ul
					class="mt-20 grid grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))] gap-12 border-t border-white/8 pt-20"
				>
					{
						missions.map(({ title, description }) => (
							<li class="rounded-18 border border-white/8 bg-background/55 px-18 py-16">
								<h4 class="text-14 leading-[1.45] font-semibold">{title}</h4>
								<p class="mt-6 text-[13.5px] leading-[1.65] text-white/70">
									{description}
								</p>
							</li>
						))
					}
				</ul>
			</div>
		</div>
	</article>
</li>

<script>
	// Dépliage des missions de la timeline, et bouton « Tout déplier / Tout replier » de la page
	// (data-missions-toggle-all). Astro n'inclut ce script qu'une fois, quel que soit le nombre de cartes.
	const toggles = document.querySelectorAll<HTMLButtonElement>(
		"[data-missions-toggle]",
	);
	const toggleAll = document.querySelector<HTMLButtonElement>(
		"[data-missions-toggle-all]",
	);

	const isOpen = (button: HTMLButtonElement) =>
		button.getAttribute("aria-expanded") === "true";

	function setOpen(button: HTMLButtonElement, open: boolean) {
		const missions = document.getElementById(
			button.getAttribute("aria-controls") ?? "",
		);
		const label = button.querySelector("[data-missions-label]");
		if (!missions || !label) return;

		missions.dataset.open = String(open);
		button.setAttribute("aria-expanded", String(open));
		label.textContent =
			(open ? button.dataset.labelOpen : button.dataset.labelClosed) ?? "";
	}

	function updateToggleAll() {
		if (!toggleAll) return;
		toggleAll.textContent = [...toggles].every(isOpen)
			? "Tout replier"
			: "Tout déplier";
	}

	toggles.forEach((button) => {
		setOpen(button, button.dataset.defaultOpen === "true");
	});

	// Lire offsetHeight force le navigateur à appliquer le repli initial sans transition ;
	// data-animated active ensuite la transition pour les clics.
	void document.body.offsetHeight;
	document
		.querySelectorAll<HTMLElement>("[data-open]")
		.forEach((missions) => missions.setAttribute("data-animated", ""));

	toggles.forEach((button) => {
		button.addEventListener("click", () => {
			setOpen(button, !isOpen(button));
			updateToggleAll();
		});
	});

	toggleAll?.addEventListener("click", () => {
		const open = ![...toggles].every(isOpen);
		toggles.forEach((button) => setOpen(button, open));
		updateToggleAll();
	});

	updateToggleAll();
</script>
