---
import { Image } from "astro:assets";
import Me from "../assets/me.webp";
import IconGithub from "./icons/IconGithub.astro";
import IconLinkedin from "./icons/IconLinkedin.astro";
import IconLocation from "./icons/IconLocation.astro";
import IconMail from "./icons/IconMail.astro";
import { contact } from "../data/contact";

// class : placement de la carte dans le hero de la page (marges, alignement…)
const { class: className } = Astro.props;
---

<aside
	aria-label="Carte de contact"
	class:list={[
		"w-full max-w-300 rounded-28 border border-card-border bg-card p-14 backdrop-blur-[6px]",
		className,
	]}
>
	<div class="relative">
		<!-- width : 2× la largeur affichée (272px), net sur les écrans Retina sans charger la photo d'origine -->
		<Image
			src={Me}
			width={544}
			alt="Portrait de Pierre Duault"
			class="aspect-[4/4.4] w-full rounded-14 border border-white/10 object-cover object-[center_35%]"
			loading="eager"
		/>
		<p
			class="absolute bottom-12 left-12 flex items-center gap-8 rounded-full border border-white/14 bg-background/72 px-12 py-6 text-12 font-medium backdrop-blur-[8px]"
		>
			<span aria-hidden="true" class="relative flex size-8">
				<span
					class="absolute inset-0 animate-ping rounded-full bg-emeraude opacity-70"
				></span>
				<span class="relative size-8 rounded-full bg-emeraude"></span>
			</span>
			Disponible
		</p>
	</div>

	<div class="px-6 pt-16 text-center">
		<h2 class="text-20 font-semibold">Pierre Duault</h2>
		<p class="mt-4 text-13 text-white/60">
			Développeur Full Stack · Pi-Code Studio
		</p>
	</div>

	<div aria-hidden="true" class="mx-4 my-14 h-1 bg-white/8"></div>

	<ul class="flex flex-col gap-2">
		<li>
			<a
				href={`mailto:${contact.email}`}
				class="row-link flex items-center gap-12 rounded-16 px-10 py-8"
			>
				<span
					class="flex size-38 flex-none items-center justify-center rounded-12 border border-white/10 bg-white/6 text-white/85"
				>
					<IconMail class="size-20" />
				</span>
				<span class="min-w-0">
					<span
						class="block text-10 font-medium tracking-[0.08em] text-white/55 uppercase"
						>Mail</span
					>
					<!-- truncate : points de suspension si l'adresse dépasse -->
					<span class="block truncate text-12 text-white/88"
						>{contact.email}</span
					>
				</span>
			</a>
		</li>
		<li class="flex items-center gap-12 px-10 py-8">
			<span
				class="flex size-38 flex-none items-center justify-center rounded-12 border border-white/10 bg-white/6 text-white/85"
			>
				<IconLocation class="size-20" />
			</span>
			<span>
				<span
					class="block text-10 font-medium tracking-[0.08em] text-white/55 uppercase"
					>Localisation</span
				>
				<span class="block text-12 text-white/88">Acigné (35)</span>
			</span>
		</li>
	</ul>

	<div class="mt-12 flex gap-8">
		<a
			href={contact.github}
			target="_blank"
			rel="noopener noreferrer"
			class="glass-btn flex min-h-44 flex-1 items-center justify-center gap-8 rounded-14 text-13 text-white/82"
		>
			<IconGithub class="size-18" />
			<span>GitHub</span>
		</a>
		<a
			href={contact.linkedin}
			target="_blank"
			rel="noopener noreferrer"
			class="glass-btn flex min-h-44 flex-1 items-center justify-center gap-8 rounded-14 text-13 text-white/82"
		>
			<IconLinkedin class="size-18" />
			<span>LinkedIn</span>
		</a>
	</div>
</aside>
