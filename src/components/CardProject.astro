---
import type { Project } from "../data/projects";
import { Image } from "astro:assets";
import IconArrowTopRight from "./icons/iconArrowTopRight.astro";
import TechBadge from "./TechBadge.astro";

// Carte d'un projet : aperçu cliquable, titre et statut, description, technos, bouton.
// linkType choisit le statut et le libellé du bouton : site en ligne ou code source sur GitHub.
// Le corps est en flex-1 et le bouton en mt-auto : les boutons d'une même ligne de la grille
// restent alignés en bas, même si les descriptions n'ont pas la même longueur.
type Props = Project;

const {
	title,
	description,
	url,
	linkType,
	featured = false,
	thumbnail,
	items,
} = Astro.props;
const isLive = linkType === "live";
---

<article
	class="flex flex-col overflow-hidden rounded-32 border border-card-border bg-card transition duration-300 ease-smooth hover:border-white/20 motion-safe:hover:-translate-y-4"
>
	<a
		href={url}
		target="_blank"
		rel="noopener noreferrer"
		aria-label={`Ouvrir ${title}`}
		class="zoom relative block aspect-video overflow-hidden border-b border-white/8 bg-background"
	>
		<!-- 1128px : deux fois la largeur maximale d'une carte (564px), net sur les écrans haute densité -->
		<Image
			src={thumbnail}
			alt={`Aperçu du projet ${title}`}
			width={1128}
			class="absolute inset-0 size-full object-cover"
			loading={featured ? "eager" : "lazy"}
		/>
		{
			featured && (
				<span class="absolute top-16 left-16 inline-flex items-center gap-8 rounded-full border border-white/14 bg-background/72 px-12 py-6 text-12 font-medium">
					<span
						aria-hidden="true"
						class="size-6 rounded-full bg-bleu-glacier"
					/>
					À la une
				</span>
			)
		}
	</a>

	<div class="flex flex-1 flex-col gap-14 px-26 pt-24 pb-26">
		<div class="flex items-center justify-between gap-12">
			<h2 class="text-24 font-semibold tracking-[-0.01em]">{title}</h2>
			{
				isLive ? (
					<span class="inline-flex flex-none items-center gap-6 font-mono text-12 text-menthe">
						<span
							aria-hidden="true"
							class="size-6 rounded-full bg-emeraude"
						/>
						En ligne
					</span>
				) : (
					<span class="flex-none font-mono text-12 text-white/60">
						Code source
					</span>
				)
			}
		</div>

		<p class="text-15 leading-[1.7] text-white/72">{description}</p>

		<div class="flex flex-wrap gap-6">
			{items.map((item) => <TechBadge {...item} />)}
		</div>

		<a
			href={url}
			target="_blank"
			rel="noopener noreferrer"
			class="glass-btn mt-auto inline-flex min-h-44 items-center gap-8 self-start rounded-full px-18 text-14 font-medium"
		>
			<span>{isLive ? "Voir le site" : "Voir sur GitHub"}</span>
			<IconArrowTopRight class="size-18" />
		</a>
	</div>
</article>
