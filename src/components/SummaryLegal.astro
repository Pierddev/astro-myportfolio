---
// Sommaire des pages légales : une pilule par page, l'onglet actif marqué par aria-current.
// Mêmes styles d'onglet que la navbar (tabState). Sur desktop, il reste visible au défilement :
// top-112 = hauteur de la navbar sticky + une marge, comme le scroll-padding de global.css.
const { currentPath } = Astro.props;
const currentPage = currentPath.split("/").filter(Boolean)[0];

const links = [
	{ page: "privacy", href: "/privacy", label: "Politique de confidentialité" },
	{ page: "legal", href: "/legal", label: "Mentions légales" },
	{ page: "terms", href: "/terms", label: "Conditions générales d’utilisation" },
].map((link) => ({ ...link, isActive: link.page === currentPage }));

const tabState = (isActive: boolean) =>
	isActive
		? "border-white/12 bg-white/8 text-white"
		: "border-transparent text-white/72 hover:bg-white/6 hover:text-white";
---

<nav
	aria-label="Pages légales"
	class="flex w-full flex-none flex-col gap-4 rounded-28 border border-card-border bg-card p-6 lg:sticky lg:top-112 lg:w-300"
>
	{
		links.map(({ href, label, isActive }) => (
			<a
				href={href}
				aria-current={isActive ? "page" : undefined}
				class:list={[
					"flex min-h-44 items-center rounded-full border px-18 py-10 text-14 transition-colors duration-200",
					tabState(isActive),
				]}
			>
				{label}
			</a>
		))
	}
</nav>
