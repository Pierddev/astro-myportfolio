---
import CardStack from "./CardStack.astro";
import GlowDot from "./GlowDot.astro";
import type { StackCategory } from "../data/stack";

// Carte d'une catégorie de la page Stack. data-stack-category sert aux filtres de la page :
// ils masquent la carte avec l'attribut hidden et rejouent l'animation reveal à son retour.
interface Props extends StackCategory {
	loading?: "lazy" | "eager";
}

const { id, title, color, items, loading = "lazy" } = Astro.props;
const count = items.length;
---

<div
	data-stack-category={id}
	class="animate-reveal rounded-32 border border-card-border bg-card p-28"
>
	<div class="mb-22 flex flex-wrap items-center justify-between gap-12">
		<h2 class="flex items-center gap-12 text-22 font-semibold">
			<GlowDot color={color} class="size-10" />
			<span>{title}</span>
		</h2>
		<span
			class="rounded-full border border-card-border bg-card px-12 py-4 font-mono text-12 text-white/65"
		>
			{count} technologie{count > 1 && "s"}
		</span>
	</div>

	<!-- auto-fill + minmax : autant de colonnes de 190px minimum que la carte le permet -->
	<ul class="grid grid-cols-[repeat(auto-fill,minmax(190px,1fr))] gap-12">
		{
			items.map((item) => (
				<li class="grid">
					<CardStack {...item} loading={loading} />
				</li>
			))
		}
	</ul>
</div>
