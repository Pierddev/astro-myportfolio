---
import { Image } from "astro:assets";

// Pilule d'une techno : logo + nom, sur un fond teinté par colorName (couleur du thème à 30 %).
// Les classes bg-{colorName}/30 sont déclarées dans global.css avec @source inline :
// une classe construite au rendu est invisible pour Tailwind, qui lit le code sans l'exécuter.
// invert : inverse les couleurs d'un logo sombre (Vercel) pour qu'il reste lisible.
interface Props {
	name: string;
	logoSrc: ImageMetadata;
	colorName: string;
	invert?: boolean;
}

const { name, logoSrc, colorName, invert = false } = Astro.props;
---

<span
	class={`inline-flex items-center gap-6 rounded-full border border-white/10 py-4 pr-10 pl-7 text-12 bg-${colorName}/30`}
>
	<Image
		src={logoSrc}
		alt=""
		width={28}
		class:list={["size-14 object-contain", invert && "invert"]}
	/>
	{name}
</span>
