---
import "../styles/global.css";
import BackgroundGlow from "../components/BackgroundGlow.astro";
import Navbar from "../components/navbar.astro";
import Footer from "../components/footer.astro";

const pathname = Astro.url.pathname;
const { title = "Développeur Full Stack" } = Astro.props;
const pageTitle = `Pierre | ${title}`;
const description =
	"Portfolio de Pierre Duault, développeur web full stack freelance basé à Rennes. Découvrez ses projets, compétences, stack et contactez-le pour vos besoins en développement web.";

// Les réseaux sociaux ne résolvent pas les chemins relatifs : URL absolues, construites à partir
// de site (astro.config.mjs). Les fichiers de public/ sont servis à la racine, sans /public.
const pageUrl = new URL(pathname, Astro.site).href;
const shareImageUrl = new URL("/og-image.jpg", Astro.site).href;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />

		<!-- SEO -->
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta
			name="keywords"
			content="Pierre Duault, développeur web, freelance, Rennes, portfolio, full stack, Pi-Code Studio"
		/>
		<meta name="author" content="Pierre Duault" />

		<!-- Open Graph (LinkedIn, Facebook, Discord…) -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Pierre Duault" />
		<meta property="og:locale" content="fr_FR" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={shareImageUrl} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1024" />
		<meta property="og:image:height" content="1024" />
		<meta
			property="og:image:alt"
			content="Pierre Duault, développeur full stack freelance basé à Rennes"
		/>

		<!-- Twitter / X : reprend titre, description et image d'Open Graph. L'image est carrée,
		     d'où la carte « summary » (vignette carrée) : « summary_large_image » la recadrerait en 2:1. -->
		<meta name="twitter:card" content="summary" />

		<!-- Favicon -->
		<link rel="icon" href="/picode.ico" />

		<!-- Générateur (Astro) -->
		<meta name="generator" content={Astro.generator} />
	</head>
	<body class="relative bg-background text-white antialiased max-w-screen">
		<BackgroundGlow />
		<!-- pointer-events-none : la bande transparente autour de la pilule laisse passer les clics vers la page -->
		<header
			class="pointer-events-none sticky top-0 z-50 flex justify-center px-16 pt-16 lg:pt-32"
		>
			<Navbar currentPath={pathname} />
		</header>
		<main>
			<slot />
		</main>
		<Footer />
		<script src="/js/script.js" defer></script>
	</body>
</html>
